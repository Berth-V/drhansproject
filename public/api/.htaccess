Options -Indexes

# Algunos servidores no le pasan a PHP el encabezado Authorization (el token de Firebase)
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# Solo se pueden abrir los endpoints
<FilesMatch "\.php$">
  Require all denied
</FilesMatch>
<FilesMatch "^insurance-(lead|upload|file|notify)\.php$">
  Require all granted
</FilesMatch>
