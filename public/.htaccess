Options -MultiViews
# /procedures es a la vez procedures.html y la carpeta procedures/: sin esto Apache redirige a /procedures/
DirectorySlash Off
RewriteEngine On

# Rutas que no existen: 404 real con la página "no encontrada" (noindex), en vez del home con 200
ErrorDocument 404 /404.html

# /home era un alias del inicio
RewriteRule ^home/?$ / [R=301,L]

# Páginas prerenderizadas por scripts/prerender.mjs: /about → about.html, /blog/mi-post → blog/mi-post.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [QSA,L]

# Rutas que solo resuelve la app (React Router): el panel, el login y los artículos publicados
# después del último build (aún no tienen su .html). Cualquier otra ruta sin archivo da 404.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(admin(/.*)?|login|blog/[A-Za-z0-9_-]+)/?$ app.html [QSA,L]

# Enable Expires headers to improve caching
<IfModule mod_expires.c>
  ExpiresActive On

  # Images - cache for 1 year
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"

  # CSS and JS - cache for 1 month
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Encabezados de seguridad para todo el sitio
<IfModule mod_headers.c>
  # Siempre por HTTPS (el navegador lo recuerda un año; Hostinger ya redirige http → https)
  Header always set Strict-Transport-Security "max-age=31536000"
  # Nadie puede meter el sitio en un iframe de otra página (clickjacking)
  Header always set X-Frame-Options "SAMEORIGIN"
  # El navegador no adivina tipos de archivo
  Header always set X-Content-Type-Options "nosniff"
  # Otros sitios solo ven el dominio de donde vino el visitante, no la ruta
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # El sitio no usa micrófono, ubicación ni pagos (la cámara del celular para fotos no usa este permiso)
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>

# Add Cache-Control headers for specific static files
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|css|js)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
</IfModule>
