Options -MultiViews
# /procedures es a la vez procedures.html y la carpeta procedures/: sin esto Apache redirige a /procedures/
DirectorySlash Off
RewriteEngine On

# Rutas que no existen: 404 real con la página "no encontrada" (noindex), en vez del home con 200
ErrorDocument 404 /404.html

# /home era un alias del inicio
RewriteRule ^home/?$ / [R=301,L]

# Páginas prerenderizadas por scripts/prerender.mjs: /about → about.html, /blog/mi-post → blog/mi-post.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [QSA,L]

# Rutas que solo resuelve la app (React Router): el panel, el login y los artículos publicados
# después del último build (aún no tienen su .html). Cualquier otra ruta sin archivo da 404.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(admin(/.*)?|login|blog/[A-Za-z0-9_-]+)/?$ app.html [QSA,L]

# Enable Expires headers to improve caching
<IfModule mod_expires.c>
  ExpiresActive On

  # Images - cache for 1 year
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"

  # CSS and JS - cache for 1 month
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Add Cache-Control headers for specific static files
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|css|js)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
</IfModule>
